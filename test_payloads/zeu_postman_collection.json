              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"reason\": \"non_delivery\",\n  \"priorityLevel\": \"HIGH\",\n  \"customerSummary\": \"Customer reports order ORD-20260726-4821 was never delivered. Requesting full refund.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/transfer-to-human",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "transfer-to-human"]
