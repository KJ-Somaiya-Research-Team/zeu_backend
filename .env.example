# Gemini API Key for Zeu AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Render sets this automatically in production)
PORT=3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster0.mongodb.net/zeu_db?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Environment Name
NODE_ENV=production
